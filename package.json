{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run --filter '*' check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-beta-18414",
    "@opencode-ai/plugin": "0.0.0-beta-18414"
  },
  "devDependencies": {
    "@opentui/solid": "^0.5.9",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "solid-js": "^1.9.15",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@opencode-ai/plugin": "0.0.0-beta-18414",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  }
}
